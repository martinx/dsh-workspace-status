{
  "name": "dsh-workspace-status",
  "version": "0.1.1",
  "private": true,
  "description": "Composer-dock pill showing the workspace git branch, change counts, ahead/behind and GitHub PR status for DeepSeek Harness.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "license": "MIT",
  "author": "Martin Xu",
  "homepage": "https://github.com/martinx/dsh-workspace-status#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/martinx/dsh-workspace-status.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "git",
    "github",
    "pull-request"
  ]
}
